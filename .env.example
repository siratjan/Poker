# Muster für .env.local (lokal) und für die Vercel-Umgebungsvariablen
# (Production + Preview, siehe docs/DEPLOY.md Schritt 3).
#
# Werte stehen im Supabase-Dashboard unter Project Settings -> API.
# Beide Variablen sind NEXT_PUBLIC_* und damit oeffentlich; die Rechte erzwingt
# RLS in der Datenbank. Der Service-Role-Key gehoert weder hierhin noch zu Vercel.
#
# .env.local wird nie committet (.gitignore).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
